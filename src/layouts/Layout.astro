---
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-700.css';
import '../styles/global.css';
import AsideMenu from '../components/AsideMenu.astro';
import ArrowRightAside from '../components/ArrowRightAside.astro';
const { lang, t } = Astro.props;
const canonical = 'https://www.lautaroportillo.dev/' + lang + '/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lautaro Portillo | Portfolio</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        document.documentElement.classList.toggle('dark', localStorage.getItem('darkMode') === 'activate');
      } catch {}
    </script>
    <meta name="description" content={t.ui.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href="https://www.lautaroportillo.dev/es/" />
    <link rel="alternate" hreflang="en" href="https://www.lautaroportillo.dev/en/" />
    <link rel="alternate" hreflang="x-default" href="https://www.lautaroportillo.dev/es/" />
    <meta property="og:title" content="Lautaro Portillo | Portfolio" />
    <meta property="og:description" content={t.ui.description} />
    <meta property="og:image" content="https://www.lautaroportillo.dev/og-image.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_UY' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.ui.skip}</a>
    <div id="app">
      <aside id="site-navigation"><AsideMenu lang={lang} t={t} /></aside>
      <ArrowRightAside t={t} />
      <div class="menu-backdrop" hidden aria-hidden="true"></div>
      <main id="main-content" tabindex="-1"><slot /></main>
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
