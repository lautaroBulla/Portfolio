---
import DarkMode from '../assets/icons/darkmode.svg';
import LightMode from '../assets/icons/lightmode.svg';

import AsideMenuContainer from './AsideMenuContainer.astro';
import SettingElement from './SettingElement.astro';
import NavElement from './NavElement.astro';

const { lang, t } = Astro.props;
---

<nav aria-label={t.ui.navigation}>
  <AsideMenuContainer class="top">

    <SettingElement class="first-element">
      {t.themeOptions.label}
      <button id="darkButton" aria-label={t.themeOptions.dark}>
        <DarkMode id="darksvg" aria-hidden="true" />
      </button>
      <button id="lightButton" aria-label={t.themeOptions.light}>
        <LightMode id="lightsvg" aria-hidden="true" />
      </button>
    </SettingElement>

    <SettingElement>
      {t.languageOptions.label}
      <div class="language-options">
      <a class="language-link" href={lang === "es" ? "/en/" : "/es/"} lang={lang === "es" ? "en" : "es"} hreflang={lang === "es" ? "en" : "es"} aria-label={lang === "es" ? "Read in English" : "Leer en español"}>{lang === "es" ? "EN" : "ES"}</a>
      </div>
    </SettingElement>
  </AsideMenuContainer>

  <AsideMenuContainer>
    <NavElement
      href="#about"
      title={t.nav.about}
    />
    <NavElement
      href="#experience"
      title={t.nav.experience}
    />
    <NavElement
      href="#projects"
      title={t.nav.projects}
    />
    <NavElement
      href="#technologies"
      title={t.nav.technologies}
    />
  </AsideMenuContainer>

  <span></span>
</nav>

<style>
  nav {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }

  .language-options { display: flex; align-items: center; gap: .25rem; }
  .language-link { border-bottom: 1px solid transparent; transition: color .18s ease, border-bottom-color .18s ease; }
  .language-link:hover { color: var(--color-object); border-bottom-color: var(--color-object); }

  button {
    filter: grayscale(100%);
    transition: transform 0.1s linear, filter 0.1s linear;
  }
  button:active {
    transform: scale(1.1);
    filter: grayscale(0%);
  }
  button svg:active {
    fill: var(--color-text);
  }

  @media (min-width: 1024px) {
    button:hover {
      cursor: pointer;
      transform: scale(1.1);
      filter: grayscale(0%);
    }
    button svg:hover {
      fill: var(--color-text);
    }
  }
</style>
