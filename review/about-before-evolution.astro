---
import LinkedInSvg from '../assets/icons/linkedin.svg';
import GitHubSvg from '../assets/icons/GitHub.svg';
import Mail from '../assets/icons/mail.svg';

const { t, id } = Astro.props;
---

<section id={id}>

  <div class="header">
    <div class="name-container">
      <h1 class="name" aria-label="&lt;Lautaro Portillo /&gt;">
        <span class="code" aria-hidden="true">
        <span style="color: var(--color-html)">&lt;</span><span style="color: var(--color-object)">Lautaro Portillo</span> <span style="color: var(--color-html)">/&gt;</span>
        </span>
      </h1>

    </div>
  </div>

  <div class="content">
    <div class="descriptions">
      <p>{t.about.description}</p>
      <p>{t.about.description2}</p>
    </div>
    <div class="links">
      <a class="border-radius" href="https://www.linkedin.com/in/lautaroportillo/" target="_blank" rel="noopener noreferrer">
        <LinkedInSvg aria-hidden="true" />
        LinkedIn
      </a>
      <a class="border-radius" href="https://github.com/lautaroBulla" target="_blank" rel="noopener noreferrer">
        <GitHubSvg aria-hidden="true" />
        GitHub
      </a>
      <a class="mail" href="mailto:lautaro.portillo.bulla@gmail.com">
        <Mail aria-hidden="true" />
        <span>lautaro.portillo.bulla@gmail.com</span>
      </a>
    </div>
  </div>

</section>

<style>
  section#about { display: flex; flex-direction: column; justify-content: center; min-height: min(900px, 100svh); padding-block: 5rem 3rem; }
  .header, .content { width: 100%; max-width: 44rem; margin-inline: auto; }
  .header { margin-bottom: 1.5rem; }
  .name { font-size: clamp(1.35rem, 3.3vw, 2.5rem); font-weight: 700; line-height: 1.35; letter-spacing: -.045em; }
  /* Preserve the original 1.8s typing and pulsing cursor without resizing the heading. */
  .name { position: relative; width: max-content; max-width: 100%; }
  .code { display: block; white-space: nowrap; animation: typing 1.8s steps(60, end) both; }
  .name::after {
    content: ''; position: absolute; top: 0; left: .1em;
    width: 100%; height: 1.35em; border-right: .1em solid var(--color-text);
    pointer-events: none;
    animation: cursor-travel 1.8s steps(60, end) both, cursorexpand 1s ease-in-out 1.8s infinite;
  }
  @keyframes typing { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes cursor-travel { from { transform: translateX(-100%); } to { transform: translateX(0); } }
  @keyframes cursorexpand { from, to { transform: scaleY(1); } 50% { transform: scaleY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .code { animation: none; clip-path: none; }
    .name::after { display: none; }
  }
  .descriptions { max-width: 66ch; line-height: 1.65; font-size: 1rem; }
  .descriptions p:first-child { max-width: 58ch; font-size: clamp(1.05rem, 1.5vw, 1.2rem); line-height: 1.55; margin-bottom: 1rem; }
  .descriptions p + p { color: var(--color-muted); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 1.5rem; }
  .links a { display: inline-flex; align-items: center; gap: .55rem; padding: .5rem .75rem; min-height: 44px; border: 1px solid var(--color-border); font-size: .85rem; }
  .links a:not(.mail):hover { border-color: var(--color-object); color: var(--color-object); }
  .links svg { flex-shrink: 0; fill: currentColor; width: 1.25rem; height: 1.25rem; }
  .links .mail { border-color: transparent; padding-inline: 0; font-size: clamp(.75rem, 1vw, .85rem); }
  .links .mail:hover { border-bottom-color: var(--color-object); color: var(--color-object); }
  .mail span { overflow-wrap: anywhere; }
  @media (min-width: 768px) {
    section#about { padding-block: 4rem; }
    .header { margin-bottom: 2rem; }
    .links { margin-top: 2rem; }
  }
</style>
